{
  "name": "typescript-hexagonal-template",
  "version": "1.0.1",
  "description": "Template for your TypeScript projects using hexagonal architecture ",
  "main": "index.js",
  "scripts": {
    "test": "cross-env ENV=test cucumber-js -p api",
    "build": "pnpm run --filter api build && pnpm run --filter landing build && pnpm run --filter mcp build && pnpm run --filter frontend build",
    "lint": "eslint --ext .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/src/apps/api/index.js"
  },
  "keywords": [],
  "author": "aperezgdev",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.3.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.15.6",
    "uuid": "^11.1.0"
  }
}

{
  "name": "typescript-hexagonal-template",
  "version": "1.0.1",
  "description": "Template for your TypeScript projects using hexagonal architecture ",
  "main": "index.js",
  "scripts": {
    "test:api": "cross-env ENV=test cucumber-js -p api",
    "dev": "cross-env ENV=test ts-node-dev --ignore-watch node_modules  ./src/apps/api/index.ts",
    "build:tsc": "tsc -p tsconfig.prod.json",
    "build:di": "find src -name '*.yaml' -exec cp --parents {} dist/ \\;",
    "build": "pnpm run build:tsc && pnpm run build:di",
    "lint": "eslint --ext .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/src/apps/api/index.js"
  },
  "keywords": [],
  "author": "aperezgdev",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.3.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.43.1",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "glob": "^10.4.5",
    "node-dependency-injection": "^3.2.2",
    "pg": "^8.15.6",
    "uuid": "^11.1.0"
  }
}

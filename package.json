{
  "name": "typescript-hexagonal-template",
  "version": "1.0.1",
  "description": "Template for your TypeScript projects using hexagonal architecture ",
  "main": "index.js",
  "scripts": {
    "test:api": "cucumber-js -p api",
    "dev": "ts-node-dev --ignore-watch node_modules  ./src/apps/api/index.ts",
    "build:tsc": "tsc -p tsconfig.prod.json",
    "build:di": "xcopy /S \"src\\*.yaml\" \"dist\\src\\\"",
    "build": "pnpm run build:tsc && pnpm run build:di",
    "lint": "eslint --ext .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "aperezgdev",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "dotenv": "^16.3.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-promise-router": "^4.1.1",
    "glob": "^10.3.10",
    "node-dependency-injection": "^3.1.2"
  }
}
